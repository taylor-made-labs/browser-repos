{
  "name": "@taylor-made-labs/browser-repos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IndexedDB-backed, Git-compatible repository library for the browser. Framework-agnostic, MV3-compatible, reusable outside the Skeleton Crew project.",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0"
  },
  "devDependencies": {
    "@types/node": "20.14.9",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "eslint": "8.57.0",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  }
}
